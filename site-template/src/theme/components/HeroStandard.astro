---
import { has } from '../../lib/site';
import type { HeroImagePosition } from '../../lib/layouts';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  imageAlt?: string;
  /** Which side the image sits on, or `none` for a text-only hero. Chosen by
      the theme's layout manifest (src/theme/layouts.json); defaults to `right`
      so the house theme renders exactly as before. */
  imagePosition?: HeroImagePosition;
}

const {
  eyebrow,
  title,
  lede,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  image,
  imageAlt = '',
  imagePosition = 'right',
} = Astro.props;

// `none` is a text-only hero — the image is dropped even when one was sourced,
// because the design's layout intent for this screen is a centered lead.
const showMedia = imagePosition !== 'none' && has(image);
---

<section class="hero">
  <div class:list={['wrap', 'hero__inner', { 'hero__inner--imageLeft': showMedia && imagePosition === 'left', 'hero__inner--noMedia': !showMedia }]}>
    <div class="hero__copy">
      {has(eyebrow) && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="hero__title">{title}</h1>
      {has(lede) && <p class="lede hero__lede">{lede}</p>}
      {(has(ctaHref) || has(secondaryHref)) && (
        <div class="hero__actions">
          {has(ctaHref) && <a class="button" href={ctaHref}>{ctaLabel}</a>}
          {has(secondaryHref) && (
            <a class="button button--ghost" href={secondaryHref}>{secondaryLabel}</a>
          )}
        </div>
      )}
    </div>
    {/* The image slot simply disappears when no image has been sourced yet
        (plan §4.7), or when the layout is text-only, rather than leaving a
        broken frame. H1 stays first in the DOM for SEO; `order` swaps sides
        visually for the image-left layout. */}
    {showMedia && (
      <div class="hero__media">
        <img src={image} alt={imageAlt} width="720" height="480" loading="eager" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
  }
  .hero__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-7);
    align-items: center;
  }
  /* Two columns only when the hero actually shows an image. A text-only hero
     stays single-column and the copy keeps its natural measure. */
  .hero__inner:has(.hero__media) {
    grid-template-columns: 1.1fr 1fr;
  }
  /* Image-left: same fluid grid, copy and media visually swapped. The heavier
     column follows the copy so the ratio stays copy-weighted either way. */
  .hero__inner--imageLeft:has(.hero__media) {
    grid-template-columns: 1fr 1.1fr;
  }
  .hero__inner--imageLeft .hero__media {
    order: -1;
  }
  .hero__title {
    font-size: var(--text-4xl);
    font-weight: 700;
    max-width: 20ch;
  }
  .hero__lede {
    margin: var(--space-5) 0 0;
    max-width: 58ch;
  }
  .hero__actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }
  .hero__media img {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    width: 100%;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .hero__inner:has(.hero__media) {
      grid-template-columns: 1fr;
    }
    /* On a stacked hero the image always follows the copy, regardless of the
       desktop side, so the H1 leads on mobile. */
    .hero__inner--imageLeft .hero__media {
      order: 0;
    }
  }
</style>
