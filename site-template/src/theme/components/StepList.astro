---
/**
 * Shared Component Library: a numbered process / step list (reference §5.1
 * Warranty — Claim process StepList; reusable for any ordered how-to). Each step
 * is an operator-supplied string. Renders nothing when empty. Mobile: full-width.
 */
interface Props {
  title?: string;
  steps: string[];
}
const { title, steps } = Astro.props;
const clean = (steps ?? []).map((s) => (s ?? '').trim()).filter(Boolean);
---

{clean.length > 0 && (
  <section class="steps">
    <div class="wrap">
      {title && <h2 class="steps__title">{title}</h2>}
      <ol class="steps__list">
        {clean.map((s) => (
          <li class="steps__item">{s}</li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .steps {
    padding-block: var(--space-6);
  }
  .steps__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }
  .steps__list {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .steps__item {
    counter-increment: step;
    position: relative;
    padding-left: calc(var(--space-8) + var(--space-2));
    min-height: var(--space-8);
    display: flex;
    align-items: center;
  }
  .steps__item::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: var(--space-8);
    height: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    font-size: var(--text-sm);
  }
</style>
