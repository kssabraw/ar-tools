---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../theme/components/PageHeader.astro';
import CardGrid from '../../theme/components/CardGrid.astro';
import ArticleCard from '../../theme/components/ArticleCard.astro';
import CtaBand from '../../theme/components/CtaBand.astro';
import ReviewStrip from '../../theme/components/ReviewStrip.astro';
import { allLocations } from '../../lib/content';
import { service } from '../../lib/schema';

// Same index-plus-detail pattern as services — see that file for why.
export const getStaticPaths: GetStaticPaths = async () => {
  const locations = await allLocations();
  if (locations.length === 0) return [];
  return [
    { params: { slug: undefined }, props: { entry: undefined, locations } },
    ...locations.map((entry) => ({ params: { slug: entry.id }, props: { entry, locations } })),
  ];
};

const { entry, locations } = Astro.props;
const Content = entry ? (await render(entry)).Content : null;
const d = entry?.data;

const ld = d
  ? (d.jsonld ?? service({ title: d.title, description: d.description, url: Astro.url.href }))
  : undefined;
---

{d && Content ? (
  <Layout title={d.title} description={d.description} image={d.heroImage} jsonld={ld}>
    <PageHeader eyebrow={d.locationName} title={d.title} lede={d.teaser || d.description} />
    <div class="prose-wrap richtext body">
      <Content />
    </div>
    <ReviewStrip />
    <CtaBand title={`Serving ${d.locationName}`} />
  </Layout>
) : (
  <Layout title="Areas we serve" description="The areas we cover.">
    <PageHeader title="Areas we serve" />
    <CardGrid min="200px">
      {locations.map((loc) => (
        <ArticleCard
          href={`/locations/${loc.id}/`}
          title={loc.data.locationName || loc.data.title}
          excerpt={loc.data.teaser}
        />
      ))}
    </CardGrid>
    <CtaBand title="Not sure if we cover you?" />
  </Layout>
)}

<style>
  .body {
    padding-bottom: var(--space-7);
  }
</style>
